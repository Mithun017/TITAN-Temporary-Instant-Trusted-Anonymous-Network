# TITAN Configuration Template
# Connect privately. Chat freely. Leave no trace.

# App & Environment
NODE_ENV=development
PORT=3001

# Client URLs (optional override for decoupled deployments)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Session & Security Constraints
ROOM_TTL_SECONDS=1800
WAITING_ROOM_TTL_SECONDS=600
DISCONNECT_GRACE_SECONDS=120
MAX_ROOM_PARTICIPANTS=2
MAX_MESSAGE_BYTES=65536
MAX_ATTACHMENT_BYTES=5242880

# Ephemeral Coordination (Optional - in-memory fallback enabled if empty)
# REDIS_URL=redis://default:token@host:port

